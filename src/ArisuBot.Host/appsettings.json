{
  "Discord": {
    "DevGuildId": "",
    "AdminUserIds": [],
    "DmWhitelistExtraUserIds": [],
    "MessageListener": {
      "ChannelIds": [],
      "RespondToMentions": true
    },
    "Tools": {
      "TimeoutMinSeconds": 60,
      "TimeoutMaxSeconds": 120
    }
  },
  "LLM": {
