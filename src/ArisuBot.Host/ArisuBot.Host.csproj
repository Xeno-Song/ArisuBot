<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ArisuBot.Core\ArisuBot.Core.csproj" />
    <ProjectReference Include="..\ArisuBot.LLM\ArisuBot.LLM.csproj" />
    <ProjectReference Include="..\ArisuBot.Discord\ArisuBot.Discord.csproj" />
    <ProjectReference Include="..\ArisuBot.Infrastructure\ArisuBot.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- appsettings.json, appsettings.Local.json, log4net.config: SDK.Web이 자동 포함 -->
    <Content Include="prompts\system.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="prompts\persona.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="prompts\compaction.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
