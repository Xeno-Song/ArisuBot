  "MonitorServer": {
    "Host": "127.0.0.1",
    "Port": 9876
  },
  "SemanticMemory": {
    "TraitCompressionThreshold": 20,
    "EventCompressionThreshold": 20,
    "EpisodeCompressionThreshold": 20,
    "CompressionModel": null
  }
