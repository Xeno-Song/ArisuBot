      "InitialThresholdTokens": 3000,
      "RefreshThresholdTokens": 20000,
      "TtlSeconds": 300,
      "VelocityWindowSeconds": 180,
      "VelocityMinMessages": 2
    }
  },
  "MongoDB": {
    "DatabaseName": "arisu_bot"
  },
  "Memory": {
    "UserContextMaxMessages": 100,
    "ChannelContextMaxMessages": 500
  },
  "Compaction": {
    "Enabled": true,
    "TokenThresholdEnabled": true,
    "TokenThreshold": 150000,
    "InactivityEnabled": false,
    "InactivityMinutes": 1440,
    "ScheduledEnabled": false,
    "ScheduledTimeUtc": "03:00",
    "CooldownMinutes": 60,
    "InjectionRecentMessageCount": 20
