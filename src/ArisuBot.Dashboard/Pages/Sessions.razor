@page "/sessions"
@inject MongoQueryService Mongo

<PageTitle>세션 목록 — ArisuBot</PageTitle>
<h4>세션 목록</h4>

@if (_loading)
{
    <p class="text-muted">로딩 중...</p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <p class="text-muted small">MongoDB conversations 컬렉션 기준. 최신 200건 조회.</p>
    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>타입</th>
                <th>대상</th>
                <th>메시지</th>
                <th>토큰In</th>
                <th>토큰Out</th>
                <th>생성</th>
                <th>최종 업데이트</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _sessions)
            {
                var tokIn  = s.TokenUsage.Sum(t => t.TokensIn);
                var tokOut = s.TokenUsage.Sum(t => t.TokensOut);
                <tr>
                    <td><code class="small">@s.Id[..Math.Min(12, s.Id.Length)]</code></td>
                    <td>@s.Type</td>
                    <td>@s.TargetId</td>
                    <td>@(s.MessageCount ?? 0)</td>
                    <td>@tokIn.ToString("N0")</td>
                    <td>@tokOut.ToString("N0")</td>
                    <td class="small">@s.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td class="small">@s.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">새로고침</button>
}

@code {
    private List<ArisuBot.Infrastructure.MongoDB.Documents.ConversationDocument> _sessions = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            _sessions = await Mongo.GetAllSessionsAsync();
        }
        catch (Exception ex)
        {
            _error = $"세션 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
